{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "resolveJsonModule": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "types": ["vite/client", "@cloudflare/workers-types"]
  },
  "include": ["src", "functions"]
}
